# Client-side project token (public by design; never use the personal API key here)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Meta Ads. El ID de Dataset/Píxel es público; el token CAPI es secreto y se
# configura sólo en Vercel. META_CAPI_API_VERSION se copia desde Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_API_VERSION=

# Server-side capture and read-only reporting
POSTHOG_SERVER_KEY=
POSTHOG_PERSONAL_API_KEY=
ANALYTICS_REPORT_SECRET=
CRON_SECRET=

# Manual report delivery (GitHub Actions or local execution)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
POSTHOG_REPORT_EMAIL_TO=
POSTHOG_REPORT_EMAIL_FROM=CrececonIA <sergio@crececonia.cl>

# Live class fulfillment (server-side only; do not expose in client code)
CLASS_WHATSAPP_GROUP_URL=
CLASS_SESSION_URL=
CLASS_ORGANIZER_EMAIL=sergio@crececonia.cl
PURCHASE_NOTIFICATION_EMAIL=sergio.bkg@gmail.com
CLASS_SUPPORT_EMAIL=sergio@crececonia.cl
# Optional: set only if a recording will be shared after the class.
CLASS_RECORDING_URL=
# Optional: purpose-specific key for aula links. FLOW_SECRET_KEY is used safely as a server-only fallback.
CLASS_HUB_ACCESS_SECRET=

# Workshop 2026-09-06 (server-side only)
WORKSHOP_ACCESS_SECRET=
WORKSHOP_SESSION_URL=
WORKSHOP_RECORDING_URL=
WORKSHOP_SKOOL_URL=
WORKSHOP_SKILLS_STORAGE_PATH=
WORKSHOP_SUPPORT_EMAIL=sergio@crececonia.cl
